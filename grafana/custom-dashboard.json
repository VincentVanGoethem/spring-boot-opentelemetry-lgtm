{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Spring Boot 4 + OpenTelemetry demo — Logs, Metrics, Traces & Profiling across the Arcane Emporium services",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1, "title": "Business Overview", "type": "row" },

    {
      "id": 2, "type": "stat", "title": "Orders (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "increase(orders_created_total{status='success'}[1h])", "refId": "A", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short", "noValue": "0" }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "Revenue (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "increase(orders_value_sum[1h])", "refId": "A", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "gold" }, "unit": "currencyUSD", "decimals": 2, "noValue": "$0.00" }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Order Success Rate",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum(rate(orders_created_total{status='success'}[$__rate_interval])) / sum(rate(orders_created_total[$__rate_interval])) * 100", "refId": "A", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "noValue": "—", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 99 }] }, "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "id": 5, "type": "stat", "title": "Magic Boxes (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "increase(orders_items_ordered_total{sku='MAGIC_BOX'}[1h])", "refId": "A", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" }, "unit": "short", "noValue": "0" }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 6, "title": "HTTP Traffic", "type": "row" },

    {
      "id": 7, "type": "timeseries", "title": "Request Rate",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (service_name) (rate(http_server_request_duration_ms_count[$__rate_interval]))", "refId": "A", "legendFormat": "{{service_name}}" }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "HTTP Error Rate",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (service_name) (rate(http_server_request_duration_ms_count{http_response_status_code=~'5..'}[$__rate_interval])) / sum by (service_name) (rate(http_server_request_duration_ms_count[$__rate_interval])) * 100",
          "refId": "A", "legendFormat": "{{service_name}}"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineInterpolation": "smooth", "fillOpacity": 15 }, "color": { "fixedColor": "red", "mode": "fixed" } }, "overrides": [] }
    },
    {
      "id": 9, "type": "timeseries", "title": "Request Latency (order-service)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_ms_bucket{service_name='order-service'}[$__rate_interval])))", "refId": "A", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.90, sum by (le) (rate(http_server_request_duration_ms_bucket{service_name='order-service'}[$__rate_interval])))", "refId": "B", "legendFormat": "P90" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_ms_bucket{service_name='order-service'}[$__rate_interval])))", "refId": "C", "legendFormat": "P99" }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineInterpolation": "smooth", "fillOpacity": 5 } }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 10, "title": "Business Trends", "type": "row" },

    {
      "id": 11, "type": "timeseries", "title": "Orders per Minute",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (status) (rate(orders_created_total[$__rate_interval])) * 60", "refId": "A", "legendFormat": "{{status}}" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineInterpolation": "smooth", "fillOpacity": 15 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 12, "type": "timeseries", "title": "Revenue per Minute",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "rate(orders_value_sum[$__rate_interval]) * 60", "refId": "A", "legendFormat": "USD / min" }
      ],
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 }, "color": { "fixedColor": "gold", "mode": "fixed" } }, "overrides": [] }
    },
    {
      "id": 13, "type": "timeseries", "title": "Items Ordered by SKU",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (sku) (rate(orders_items_ordered_total[$__rate_interval])) * 60", "refId": "A", "legendFormat": "{{sku}}" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineInterpolation": "smooth", "fillOpacity": 10, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "id": 14, "title": "Order Service — JVM", "type": "row" },

    {
      "id": 15, "type": "timeseries", "title": "Heap Memory",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (jvm_memory_pool_name) (jvm_memory_used_bytes{service_name='order-service', jvm_memory_type='heap'})", "refId": "A", "legendFormat": "Used · {{jvm_memory_pool_name}}" },
        { "expr": "sum(jvm_memory_limit_bytes{service_name='order-service', jvm_memory_type='heap'})", "refId": "B", "legendFormat": "Max" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Max" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 16, "type": "timeseries", "title": "CPU Utilization",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "jvm_cpu_recent_utilization{service_name='order-service'} * 100", "refId": "A", "legendFormat": "JVM CPU" },
        { "expr": "system_cpu_utilization{service_name='order-service'} * 100", "refId": "B", "legendFormat": "System CPU" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineInterpolation": "smooth", "fillOpacity": 15 } }, "overrides": [] }
    },
    {
      "id": 17, "type": "timeseries", "title": "Threads & Classes",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "jvm_thread_count{service_name='order-service'}", "refId": "A", "legendFormat": "Threads" },
        { "expr": "jvm_class_count{service_name='order-service'}", "refId": "B", "legendFormat": "Loaded Classes" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineInterpolation": "smooth" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Loaded Classes" }, "properties": [{ "id": "custom.axisPlacement", "value": "right" }] }
        ]
      }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "id": 18, "title": "Service Method Observations (@Observed)", "type": "row" },

    {
      "id": 19, "type": "timeseries", "title": "Order Service — Method Duration",
      "description": "Spans produced by @Observed(name = \"order.service\") on OrderService",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, method) (rate(order_service_seconds_bucket[$__rate_interval])))", "refId": "A", "legendFormat": "P50 {{method}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, method) (rate(order_service_seconds_bucket[$__rate_interval])))", "refId": "B", "legendFormat": "P99 {{method}}" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineInterpolation": "smooth", "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 20, "type": "timeseries", "title": "Mystery Box Service — Method Duration",
      "description": "Spans produced by @Observed(name = \"mystery.box.service\") on MysteryBoxService",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, method) (rate(mystery_box_service_seconds_bucket[$__rate_interval])))", "refId": "A", "legendFormat": "P50 {{method}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, method) (rate(mystery_box_service_seconds_bucket[$__rate_interval])))", "refId": "B", "legendFormat": "P99 {{method}}" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineInterpolation": "smooth", "fillOpacity": 5 } }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 }, "id": 21, "title": "Mystery Box Service & Spring AI", "type": "row" },

    {
      "id": 22, "type": "stat", "title": "Boxes Generated (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "increase(mystery_boxes_generated_total{status='success'}[1h])", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "purple", "mode": "fixed" }, "unit": "short", "noValue": "0" }, "overrides": [] }
    },
    {
      "id": 23, "type": "stat", "title": "Avg Items per Box",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "increase(mystery_box_items_count_sum[1h]) / increase(mystery_box_items_count_count[1h])", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "noValue": "—" }, "overrides": [] }
    },
    {
      "id": 24, "type": "timeseries", "title": "AI Operation Duration (Spring AI gen_ai observations)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_ms_bucket{service_name='mystery-box-service'}[$__rate_interval])))", "refId": "A", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_operation_duration_ms_bucket{service_name='mystery-box-service'}[$__rate_interval])))", "refId": "B", "legendFormat": "P99" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 25, "type": "timeseries", "title": "Mystery Box Generation Rate",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (status) (rate(mystery_boxes_generated_total[$__rate_interval])) * 60", "refId": "A", "legendFormat": "{{status}}" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineInterpolation": "smooth", "fillOpacity": 15 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 26, "type": "timeseries", "title": "AI Token Usage",
      "description": "Token usage from Spring AI gen_ai semantic convention observations",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_total{service_name='mystery-box-service'}[$__rate_interval]))", "refId": "A", "legendFormat": "{{gen_ai_token_type}}" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineInterpolation": "smooth", "fillOpacity": 5 } }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 }, "id": 27, "title": "Logs (Loki)", "type": "row" },

    {
      "id": 28, "type": "timeseries", "title": "Log Rate by Level",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 55 },
      "datasource": { "type": "loki", "uid": "${loki_datasource}" },
      "targets": [
        { "expr": "sum by (detected_level) (rate({service_name=~\"order-service|mystery-box-service\"}[$__rate_interval]))", "refId": "A", "legendFormat": "{{detected_level}}", "queryType": "range" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 29, "type": "logs", "title": "Error Logs",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 55 },
      "datasource": { "type": "loki", "uid": "${loki_datasource}" },
      "targets": [
        { "expr": "{service_name=~\"order-service|mystery-box-service\"} | detected_level = `error`", "refId": "A", "queryType": "range" }
      ],
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "showLabels": false, "sortOrder": "Descending", "wrapLogMessage": true }
    },
    {
      "id": 30, "type": "logs", "title": "All Logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 61 },
      "datasource": { "type": "loki", "uid": "${loki_datasource}" },
      "targets": [
        { "expr": "{service_name=~\"order-service|mystery-box-service\"}", "refId": "A", "queryType": "range" }
      ],
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "showLabels": true, "sortOrder": "Descending", "wrapLogMessage": false }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 71 }, "id": 31, "title": "Distributed Traces (Tempo)", "type": "row" },

    {
      "id": 32, "type": "traces", "title": "Recent Traces",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 72 },
      "datasource": { "type": "tempo", "uid": "${tempo_datasource}" },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "filters": [
            { "id": "service-name", "operator": "=", "scope": "resource", "tag": "service.name", "value": ["order-service", "mystery-box-service"], "valueType": "string" }
          ],
          "refId": "A",
          "limit": 20
        }
      ],
      "options": {}
    },
    {
      "id": 33, "type": "nodeGraph", "title": "Service Map",
      "description": "Distributed trace service topology — shows call graph between order-service and mystery-box-service",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 82 },
      "datasource": { "type": "tempo", "uid": "${tempo_datasource}" },
      "targets": [
        {
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": "{}"
        }
      ],
      "options": {}
    }

  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["spring-boot", "opentelemetry", "demo"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Loki",
        "name": "loki_datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Tempo",
        "name": "tempo_datasource",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Arcane Emporium — OpenTelemetry",
  "uid": "arcane-emporium-otel",
  "version": 1,
  "weekStart": ""
}
